{
  "name": "ocean-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drift \u2014 Atmospheric Ocean Prototype 0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ship:response": "node tools/export-ship-response.mjs",
    "ship:encounter": "node tools/export-ship-encounter.mjs",
    "ship:resistance": "node tools/export-ship-resistance.mjs",
    "ship:dynamics": "node tools/export-ship-dynamics.mjs",
    "ship:dynamics:response": "node tools/export-ship-dynamics-response.mjs",
    "ship:sailing": "node tools/export-ship-sailing.mjs",
    "ship:polar": "node tools/export-ship-polar.mjs",
    "ship:turn": "node tools/export-ship-turn.mjs",
    "ship:tack": "node tools/export-ship-tack.mjs",
    "ship:helm": "node tools/export-ship-helm.mjs",
    "ship:crew": "node tools/export-ship-crew.mjs",
    "ship:voyage": "node tools/export-ship-voyage.mjs",
    "ship:wake": "node tools/export-ship-wake.mjs",
    "ship:belowdecks": "node tools/plot-below-decks.mjs",
    "inspect:view": "node tools/inspect-view.mjs",
    "wind:baseline": "node tools/export-world-wind.mjs",
    "weather:series": "node tools/export-weather-series.mjs",
    "weather:seatrace": "node tools/export-wind-sea.mjs",
    "test": "vitest run --tagsFilter='!slow'",
    "test:full": "vitest run",
    "test:slow": "vitest run --tagsFilter='slow'",
    "test:slow:sailing": "vitest run --tagsFilter='slow && sailing'",
    "test:slow:ship-physics": "vitest run --tagsFilter='slow && ship-physics'",
    "test:slow:rig-geometry": "vitest run --tagsFilter='slow && rig-geometry'",
    "test:watch": "vitest --tagsFilter='!slow'",
    "test:watch:full": "vitest",
    "typecheck": "tsc --noEmit",
    "capture-server": "node tools/capture-server.mjs evidence 5199",
    "perf:preflight": "node tools/perf/preflight.mjs",
    "perf:revisions": "node tools/perf/run-revisions.mjs",
    "perf:campaign:southern-afternoon": "node tools/perf/run-revisions.mjs --campaign southern-afternoon-history",
    "perf:campaign:master-history": "node tools/perf/run-revisions.mjs --campaign current-master-history",
    "perf:campaign:rebaseline": "node tools/perf/run-revisions.mjs --campaign current-rebaseline",
    "perf:dashboard": "node tools/perf/dashboard.mjs",
    "perf:tooling:test": "node tools/perf/self-test.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "geographiclib-geodesic": "2.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
